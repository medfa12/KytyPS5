# Visual Studio 2015 cache/options directory
.vs/
.idea/
build/
_Build/vscode-clang/
_Build/
cmake-build-debug/
_PipelineCache/

# Inspiration checkouts (RPCSX). Never tracked.
# 13.60 target payloads + ps5oracle docs stay outside Git too.
/reference/**
/firmware/**

# Local emulator probe logs + NID db. Never tracked.
/_ProbeLogs/**

# Local run logs + pid files. Never tracked.
/_Logs/**
/*.log
/*.pid

# Emulator guest-printf stream (default --printf-output-file). The runner pins
# it to /_Runs/<run>/_kyty.txt; the legacy repo-root copy is never tracked.
/_kyty.txt

# Local per-run state: guest managed-image stage, ipc/system data, and the
# per-run emulator streams. All regenerated by tools/run_shellui_1360.ps1.
/_Runs/**
/_SystemData/**
/_ShellUIManaged/**

# Working notes / research docs. They live in the tree so the agent can re-read
# them across sessions, but they are not part of the emulator and are never
# committed. (Files already tracked keep being tracked by Git.)
/docs/**
!/docs/screenshots/
!/docs/screenshots/**

# Local scratch: extracted firmware, decrypted payloads, probe output, and
# stashed state. Regenerated on demand; never tracked.
/_TempData/**
/_FwData/**
/_FwData.bak/**
/_FwData_backup_run87plus/**
/_StateStash_*/**
/_Shaders/**
/_reports/**
/_Decomp/**
/_*.py
/*.png
/*.txt
/asmid.py
/asmver.py
/dis_elf.py
/dis_hush.py
/exports.py
/extract_psm.py
/findref*.py
/home.ps1
/hush_nids.json
/modrow.py
/nid*.py
/pltmap.py
/scenid.py
/scratch_*.py
/show_impl.py
/sortcheck.py
/strsearch.py
/tools/ida_*.py
/tools/decompile_*.py
/tools/find_*.py

CMakeUserPresets.json

# Machine-local configuration, profiles and generated captures.
/Kyty.ini
/.env
/.env.local
/launches/
/_DownloadData/
**/__pycache__/
/frame0.rgba
